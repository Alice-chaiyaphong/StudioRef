rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{coll}/{documentId} {
      // Security rules for the "users" collection
      allow read: if coll == "users";
      allow write: if coll == "users" && (request.auth != null && (request.auth.uid == documentId || request.auth.uid != null));

      // Security rules for FCM push notification tokens
      allow read, write: if coll == "fcm_tokens";

      // Security rules for application notifications
      allow read: if coll == "notifications";
      allow write: if coll == "notifications" && request.auth != null;

      // Security rules for the "My Desing" collection (portfolio designs and palettes)
      allow read: if coll == "My Desing";
      allow create, update, delete: if coll == "My Desing" && request.auth != null;
    }
  }
}
